# Copie para .env (ignorado pelo git). O docker compose lê este arquivo automaticamente.
# Os valores abaixo já são os padrões de dev; tudo é opcional.

# --- Postgres (docker-compose.dev.yml) ---
POSTGRES_USER=citros
POSTGRES_PASSWORD=citros
POSTGRES_DB=citros
# Porta no host. Use outra se a 5432 já estiver ocupada.
POSTGRES_PORT=5434

# --- API (ASP.NET Core) ---
# Em dev a API já traz a connection string em appsettings.Development.json (porta 5434).
# Para sobrescrever, exporte a variável de ambiente abaixo ao rodar `dotnet run`.
# ConnectionStrings__Default=Host=localhost;Port=5434;Database=citros;Username=citros;Password=citros
# Aplica as migrations ao subir a API (true em dev).
# Database__MigrateOnStartup=true
