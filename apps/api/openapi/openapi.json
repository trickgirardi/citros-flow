{
  "openapi": "3.1.1",
  "info": {
    "title": "Citros Flow API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "get": {
        "tags": [
          "Auth"
        ],
        "operationId": "Login",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Found"
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "Logout",
        "responses": {
          "302": {
            "description": "Found"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "operationId": "GetMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/boards": {
      "get": {
        "tags": [
          "Boards"
        ],
        "operationId": "ListBoards",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BoardResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/boards/{boardId}": {
      "get": {
        "tags": [
          "Boards"
        ],
        "operationId": "GetBoard",
        "parameters": [
          {
            "name": "boardId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoardDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/boards/{boardId}/months/{month}": {
      "get": {
        "tags": [
          "Transacoes"
        ],
        "operationId": "GetMonthSummary",
        "parameters": [
          {
            "name": "boardId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonthSummaryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/boards/{boardId}/suggestions": {
      "get": {
        "tags": [
          "Transacoes"
        ],
        "operationId": "GetSuggestions",
        "parameters": [
          {
            "name": "boardId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuggestionsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/boards/{boardId}/reserves": {
      "get": {
        "tags": [
          "Reservas"
        ],
        "operationId": "ListReserves",
        "parameters": [
          {
            "name": "boardId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReserveDto"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BoardDetailResponse": {
        "required": [
          "id",
          "name",
          "canMutate"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "canMutate": {
            "type": "boolean"
          }
        }
      },
      "BoardResponse": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CategoryGroupDto": {
        "required": [
          "category",
          "total",
          "transactions"
        ],
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "total": {
            "pattern": "^-?\\d+(\\.\\d+)?$",
            "type": "string",
            "format": "decimal"
          },
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionDto"
            }
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "required": [
          "id",
          "email",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MonthSummaryResponse": {
        "required": [
          "month",
          "previousBalance",
          "entradasTotal",
          "saidasTotal",
          "balance",
          "reservesTotal",
          "transactionCount",
          "entradas",
          "saidas"
        ],
        "type": "object",
        "properties": {
          "month": {
            "type": "string"
          },
          "previousBalance": {
            "pattern": "^-?\\d+(\\.\\d+)?$",
            "type": "string",
            "format": "decimal"
          },
          "entradasTotal": {
            "pattern": "^-?\\d+(\\.\\d+)?$",
            "type": "string",
            "format": "decimal"
          },
          "saidasTotal": {
            "pattern": "^-?\\d+(\\.\\d+)?$",
            "type": "string",
            "format": "decimal"
          },
          "balance": {
            "pattern": "^-?\\d+(\\.\\d+)?$",
            "type": "string",
            "format": "decimal"
          },
          "reservesTotal": {
            "pattern": "^-?\\d+(\\.\\d+)?$",
            "type": "string",
            "format": "decimal"
          },
          "transactionCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "entradas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryGroupDto"
            }
          },
          "saidas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryGroupDto"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ReserveDto": {
        "required": [
          "id",
          "name",
          "amount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "amount": {
            "pattern": "^-?\\d+(\\.\\d+)?$",
            "type": "string",
            "format": "decimal"
          }
        }
      },
      "SuggestionsResponse": {
        "required": [
          "categories",
          "descriptions"
        ],
        "type": "object",
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "descriptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TransactionDto": {
        "required": [
          "id",
          "type",
          "amount",
          "description",
          "category",
          "date"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/TransactionType"
          },
          "amount": {
            "pattern": "^-?\\d+(\\.\\d+)?$",
            "type": "string",
            "format": "decimal"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "TransactionType": {
        "enum": [
          "entrada",
          "saida"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Boards"
    },
    {
      "name": "Transacoes"
    },
    {
      "name": "Reservas"
    }
  ]
}